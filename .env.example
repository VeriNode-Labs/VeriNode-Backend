# HTTP listener
PORT=4000

# Soroban RPC endpoint the indexer polls for anchored proof events
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443

# VeriNode contract instance emitting `proof` events
CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Local SQLite store
DB_PATH=./data/verinode.db

# Ephemeral telemetry retention window (hours)
RETENTION_HOURS=24